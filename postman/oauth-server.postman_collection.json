{
  "info": {
    "_postman_id": "9f0ec4e8-0e1f-4d72-8c0a-4f6af4dc5d91",
    "name": "Demo Authentication Server - OAuth/OIDC",
    "description": "Postman collection for the OAuth 2.0 / OpenID Connect endpoints exposed by the auth server in this project.\n\nThis collection targets the endpoints configured by `AuthConfig` and does not include the separate `/clients` management API from `openapi-client-management.yaml`.\n\nIf `/oauth2/authorize` returns a 302 redirect, disable automatic redirects in Postman so you can capture the authorization code from the `Location` header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "OpenID Configuration",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/.well-known/openid-configuration",
            "description": "OpenID Connect discovery document."
          }
        },
        {
          "name": "OAuth Authorization Server Metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/.well-known/oauth-authorization-server",
            "description": "OAuth 2.0 authorization server metadata."
          }
        },
        {
          "name": "JWK Set",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
