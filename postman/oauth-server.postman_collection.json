            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token",
                  "type": "text"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/oauth2/token",
            "description": "Uses the refresh token to obtain a new access token for the public client."
          }
        },
        {
          "name": "UserInfo",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/userinfo",
            "description": "Calls the OpenID Connect UserInfo endpoint with the access token returned by `/oauth2/token`."
          }
        }
      ]
    },
